    {
      "name": "06. Emergencies & Dispatch Workflow",
      "item": [
        {
          "name": "1. Request Emergency (Auto-Assign Nearest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('emergencyId', json.data.id);",
                  "}",
                  "if (json.data && json.data.dispatch) {",
                  "  pm.collectionVariables.set('dispatchId', json.data.dispatch.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospitalId\": \"{{hospitalId}}\",\n  \"pickupLocation\": \"Broadway & Wall St, New York, NY\",\n  \"pickupLat\": 40.7071,\n  \"pickupLng\": -74.0110,\n  \"ambulanceType\": \"ICU\",\n  \"urgencyLevel\": \"CRITICAL\",\n  \"notes\": \"Patient experiencing severe respiratory distress.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/emergencies", "host": ["{{baseUrl}}"], "path": ["api", "v1", "emergencies"] }
          }
        },
        {
          "name": "2. Get Emergency Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/emergencies/{{emergencyId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "emergencies", "{{emergencyId}}"] }
          }
        },
        {
          "name": "3. Driver Accepts Dispatch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{driverToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{dispatchId}}/accept", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{dispatchId}}", "accept"] }
          }
        },
        {
          "name": "4. Driver State -> EN_ROUTE",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EN_ROUTE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{dispatchId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{dispatchId}}", "status"] }
          }
        },
        {
          "name": "5. Driver State -> ARRIVED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ARRIVED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{dispatchId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{dispatchId}}", "status"] }
          }
        },
        {
          "name": "6. Driver State -> PICKED_UP",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PICKED_UP\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{dispatchId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{dispatchId}}", "status"] }
          }
        },
        {
          "name": "7. Driver State -> AT_HOSPITAL",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AT_HOSPITAL\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{dispatchId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{dispatchId}}", "status"] }
          }
        },
        {
          "name": "8. Driver State -> COMPLETED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{dispatchId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{dispatchId}}", "status"] }
          }
        },
        {
          "name": "Cancel Emergency (Rejected after EN_ROUTE)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Family member drove instead.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/emergencies/{{emergencyId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "v1", "emergencies", "{{emergencyId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "07. Payments",
      "item": [
        {
          "name": "Initiate Payment for Emergency",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.payment) {",
                  "  pm.collectionVariables.set('paymentId', json.data.payment.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emergencyId\": \"{{emergencyId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/initiate", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "initiate"] }
          }
        },
        {
          "name": "Get Payment Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "{{paymentId}}"] }
          }
        },
        {
          "name": "Get My Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/payments/my?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "my"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Stripe Webhook (Mock/Live)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "stripe-signature", "value": "mock_test_signature" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_webhook_001\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_test_mock_123\",\n      \"status\": \"succeeded\",\n      \"amount_received\": 10500\n    }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/payments/webhook", "host": ["{{baseUrl}}"], "path": ["api", "v1", "payments", "webhook"] }
          }
        }
      ]
    },
    {
      "name": "08. Admin & Audit",
      "item": [
