              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "audit-logs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "entity", "value": "Emergency" }
