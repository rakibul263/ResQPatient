              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"DRIVER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/users/{{lastRegisteredUserId}}/role", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "users", "{{lastRegisteredUserId}}", "role"] }
          }
        },
        {
          "name": "View Immutable Audit Logs",
          "request": {
