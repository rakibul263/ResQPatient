            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Patient@12345\",\n  \"newPassword\": \"Patient@NewPass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/me/password", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "me", "password"] }
          }
        }
      ]
    },
    {
      "name": "03. Drivers",
      "item": [
        {
          "name": "Get Driver Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{driverToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/drivers/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drivers", "me"] }
          }
        },
        {
          "name": "Update Driver Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"experienceYears\": 6,\n  \"licenseNumber\": \"DL-NYC-UPDATED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/drivers/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drivers", "me"] }
          }
        },
        {
          "name": "Toggle Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/drivers/me/availability", "host": ["{{baseUrl}}"], "path": ["api", "v1", "drivers", "me", "availability"] }
          }
        },
        {
          "name": "Get Driver Trip History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{driverToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/drivers/me/trips?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "drivers", "me", "trips"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04. Ambulances",
      "item": [
        {
          "name": "Create Ambulance (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"AMB-NEW-999\",\n  \"vehicleType\": \"ICU\",\n  \"currentLat\": 40.7128,\n  \"currentLng\": -74.0060\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/ambulances", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ambulances"] }
          }
        },
        {
          "name": "List Ambulances",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "  pm.collectionVariables.set('ambulanceId', json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ambulances?page=1&limit=10&status=AVAILABLE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ambulances"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "AVAILABLE" }
              ]
            }
          }
        },
        {
          "name": "Get Ambulance by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/ambulances/{{ambulanceId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ambulances", "{{ambulanceId}}"] }
          }
        },
        {
          "name": "Find Nearby Ambulances (Haversine Geo)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ambulances/nearby?lat=40.7128&lng=-74.0060&radius=25&type=ICU",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ambulances", "nearby"],
              "query": [
                { "key": "lat", "value": "40.7128" },
                { "key": "lng", "value": "-74.0060" },
                { "key": "radius", "value": "25" },
                { "key": "type", "value": "ICU" }
              ]
            }
          }
        },
        {
          "name": "Update GPS Coordinates",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{driverToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentLat\": 40.7150,\n  \"currentLng\": -74.0080\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/ambulances/{{ambulanceId}}/location", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ambulances", "{{ambulanceId}}", "location"] }
          }
        },
        {
          "name": "Update Ambulance Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/ambulances/{{ambulanceId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ambulances", "{{ambulanceId}}", "status"] }
          }
        },
        {
          "name": "Soft Delete Ambulance (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/ambulances/{{ambulanceId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "ambulances", "{{ambulanceId}}"] }
          }
        }
      ]
    },
