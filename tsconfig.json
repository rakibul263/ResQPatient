{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src", 
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
